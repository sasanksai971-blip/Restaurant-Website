datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String         @id @default(cuid())
  phone     String         @unique
  name      String?
  email     String?
  createdAt DateTime       @default(now())
  addresses Address[]
  carts     Cart[]
  orders    Order[]
  bookings  TableBooking[]
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  addressLine String
  city        String
  state       String
  postalCode  String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id])
  orders      Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  image    String?
  products Product[]
}

model Product {
  id              String      @id @default(cuid())
  categoryId      String
  name            String
  description     String
  image           String?
  price           Float
  discountedPrice Float?
  isVeg           Boolean     @default(true)
  isBestSeller    Boolean     @default(false)
  ingredients     String?
  calories        Int?
  protein         Float?
  carbs           Float?
  fat             Float?
  sugar           Float?
  sodium          Float?
  category        Category    @relation(fields: [categoryId], references: [id])
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

model Cart {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String?
  quantity      Int      @default(1)
  customization String?
  price         Float
  cart          Cart     @relation(fields: [cartId], references: [id])
  product       Product? @relation(fields: [productId], references: [id])
}

model Store {
  id          String         @id @default(cuid())
  name        String
  address     String
  city        String
  latitude    Float
  longitude   Float
  openingTime String
  closingTime String
  isOpen      Boolean        @default(true)
  orders      Order[]
  bookings    TableBooking[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  storeId       String?
  addressId     String?
  orderType     String // delivery | takeaway | dine-in | scheduled
  status        String      @default("placed") // placed | preparing | ready | out_for_delivery | delivered | picked_up | served
  subtotal      Float
  discount      Float       @default(0)
  tax           Float
  deliveryFee   Float       @default(0)
  total         Float
  scheduledDate String?
  scheduledTime String?
  couponCode    String?
  paymentMethod String? // upi | card | cod
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  store         Store?      @relation(fields: [storeId], references: [id])
  address       Address?    @relation(fields: [addressId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  quantity      Int
  price         Float
  customization String?
  order         Order    @relation(fields: [orderId], references: [id])
  product       Product? @relation(fields: [productId], references: [id])
}

model Offer {
  id          String  @id @default(cuid())
  title       String
  description String
  discount    String
  color       String  @default("blue") // blue | orange
  isActive    Boolean @default(true)
  image       String?
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String
  discountType  String // percentage | fixed
  discountValue Float
  minimumOrder  Float     @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  validUntil    DateTime?
  isActive      Boolean   @default(true)
}

model TableBooking {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  date      String
  time      String
  guests    Int
  status    String   @default("pending") // pending | confirmed | cancelled
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
}

model BulkOrder {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String
  eventDate    String
  eventType    String
  guestCount   Int
  location     String
  requirements String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}

// ─── Custom Pizza Models ──────────────────────────────────────────────────

model PizzaSize {
  id          String  @id @default(cuid())
  name        String // Small | Medium | Large
  description String // Serves 1 | Serves 2 | Serves 3-4
  basePrice   Float // 199 | 299 | 399
  servingSize String // e.g. "7 inches (4 slices)"
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model PizzaCrust {
  id              String  @id @default(cuid())
  name            String // Classic Hand Tossed | Thin Crust | Cheese Burst | Stuffed Crust
  description     String
  additionalPrice Float // 0 | 30 | 80 | 100
  active          Boolean @default(true)
  sortOrder       Int     @default(0)
}

model PizzaSauce {
  id              String  @id @default(cuid())
  name            String // Classic Tomato | Spicy Tomato | BBQ | Garlic Herb
  description     String
  additionalPrice Float   @default(0)
  color           String  @default("#C62828") // Hex color for visualizer
  active          Boolean @default(true)
  sortOrder       Int     @default(0)
}

model PizzaCheese {
  id              String  @id @default(cuid())
  name            String // Mozzarella | Extra Mozzarella | Cheddar Blend | Vegan Cheese
  description     String
  additionalPrice Float   @default(0) // 0 | 40 | 50 | 70
  color           String  @default("#FFF9C4") // Hex color for visualizer
  active          Boolean @default(true)
  sortOrder       Int     @default(0)
}

model PizzaTopping {
  id         String  @id @default(cuid())
  name       String // Onion, Capsicum, Mushroom, Chicken, Pepperoni, etc.
  category   String // Vegetables | Non-Veg | Premium
  price      Float // Regular price (e.g. 30, 40, 60)
  extraPrice Float // Extra portion price (e.g. 50, 70, 80)
  vegetarian Boolean @default(true)
  image      String? // SVG symbol / Icon name / Color marker
  color      String  @default("#E53935") // Visual marker color
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

model PizzaExtra {
  id        String  @id @default(cuid())
  name      String // Extra Cheese | Garlic Dip | Spicy Dip | Garlic Bread | Coke | Brownie
  category  String // Dips | Breads | Drinks | Desserts
  price     Float // 30 | 50 | 99 | 60 | 89
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}
